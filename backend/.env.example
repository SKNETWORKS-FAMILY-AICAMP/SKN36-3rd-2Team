# NPC LLM (Ollama 또는 OpenAI)
LLM_PROVIDER=ollama
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=실제_키는_backend/.env_에만_설정
OPENAI_TIMEOUT_SECONDS=35
CRIMESCENE_LLM_MAX_TOKENS=1024

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Qdrant
QDRANT_URL=http://127.0.0.1:6333

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_to_a_secure_password

# CASE-001 데이터 (프로젝트 루트 기준 상대경로)
CRIMESCENE_CASE001_ROOT=.local/case001_v7_1CRIMESCENE_SESSION_SECRET=replace_with_random_secret_at_least_32_bytes
CRIMESCENE_ENABLE_CHAT=true
CRIMESCENE_COOKIE_SECURE=false
CRIMESCENE_DB_PATH=data/game_state.sqlite3
CRIMESCENE_CASE_TRUTH_PATH=
